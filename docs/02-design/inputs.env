# ─────────────────────────────────────────────────────────────
# 项目输入清单 · 个人简历站
# 用法：等号左边不要改，把右边替换成你的真实内容。
#       只填 value，不删 key；暂缺的保持原样，我按未填处理。
# 禁止：不要在这里写密码、API Key、Token（需要时改用 GitHub Secrets）。
# 标注「# 示例」的值是我代填的占位数据，仅用于跑通渲染，上线前必须替换。
# ─────────────────────────────────────────────────────────────

# ── 1. 站点（必填）────────────────────────────────────────────
# 你的 GitHub 用户名，决定默认访问地址 <用户名>.github.io/resume_website
SITE_GITHUB_USERNAME=yangchenyang1001
# 仓库名，已定，一般不用改
SITE_REPO_NAME=resume_website
# 已定 public（2026-10-30）：仓库公开，勿写手机号、住址、公司内部信息
SITE_VISIBILITY=public
# 自定义域名，如 wangwu.dev；不买就填 none
SITE_DOMAIN=none
# 浏览器标签与 PDF 页眉里显示的站点名
SITE_TITLE=杨晨阳 · Agent 工程
# 一句话定位，全站只出现一次，置于首屏
SITE_TAGLINE=把 RAG 从 Demo 做到能上线
# 唯一技术标签，只填一个：如 RAG / Agent 编排 / 检索优化
SITE_TECH_TAG=RAG

# ── 2. 联系方式（必填，至少一项）──────────────────────────────
CONTACT_EMAIL=437792910@qq.com
CONTACT_GITHUB_URL=https://yangchenyang1001.github.io/
# 微信 / 知乎 / 掘金等，没有填 none
CONTACT_OTHER=none

# ── 3. 首页三个项目卡片（必填，至少 PROJECT_1）──────────────────
# HIGHLIGHT 是一条量化结果；为空的项目不会出现在首页
PROJECT_1_SLUG=rag
PROJECT_1_TITLE=产品智库
PROJECT_1_ROLE=独立开发
# 示例
PROJECT_1_STACK=Java, Spring AI, Milvus, Redis, RAGAS
# 示例
PROJECT_1_HIGHLIGHT=召回率 0.82 → 0.91，P95 稳定在 1.6s 内

# 示例（整块为占位，替换或留空）
PROJECT_2_SLUG=agent-workflow
PROJECT_2_TITLE=多智能体任务编排
PROJECT_2_ROLE=后端开发
PROJECT_2_STACK=Spring AI, Redis, MySQL, 状态机
PROJECT_2_HIGHLIGHT=任务成功率 76% → 89%

# 示例（整块为占位，替换或留空）
PROJECT_3_SLUG=api-perf
PROJECT_3_TITLE=订单接口性能治理
PROJECT_3_ROLE=后端开发
PROJECT_3_STACK=Spring Boot, MySQL, Arthas, JMeter
PROJECT_3_HIGHLIGHT=P95 420ms → 90ms

# ── 4. RAG 详情页量化表（必填，缺项要说明原因）─────────────────
# 示例
RAG_RAGAS_FAITHFULNESS=0.86
# 示例
RAG_RAGAS_ANSWER_RELEVANCY=0.82
# 示例
RAG_P95_RETRIEVAL_MS=180
# 示例
RAG_P95_GENERATION_MS=1400
# 示例
RAG_TOKEN_COST_PER_QA=0.021 元/次
# 示例
RAG_DOC_COUNT=1200
# 示例
RAG_CHUNK_COUNT=18600

# ── 5. 素材（O5 完成后回填）───────────────────────────────────
# 录屏外链；仓库不适合放 >50MB 视频
# 示例
ASSET_RECORDING_URL=https://www.bilibili.com/video/BV1xx411c7XX
# 架构图：仓库内相对路径或图片链接
# 示例
ASSET_ARCHITECTURE_IMG=src/assets/rag-architecture.png
# 公开仓库地址
# 示例
ASSET_REPO_URL=https://github.com/yangchenyang1001/rag-product-knowledge-base
# 一键启动方式，一句话，如「docker compose up，5 分钟跑起来」
# 示例
ASSET_QUICKSTART=docker compose up，5 分钟跑起来

# ── 6. 部署后回填（O3 / O6 完成后填）──────────────────────────
# 站点实际可访问地址（由用户名与仓库名推导，非猜测）
PAGES_URL=https://yangchenyang1001.github.io/resume_website/
# 首次流水线是否成功：ok / 失败现象；部署前保持 pending
PAGES_ACTIONS_FIRST_RUN=pending
# 域名是否解析完成：yes / no / 未购买
DOMAIN_DNS_DONE=no
